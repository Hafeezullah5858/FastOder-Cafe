rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function role() { return signedIn() ? userDoc(request.auth.uid).role : null; }
    function isAdmin() { return role() == 'admin'; }
    function isVendor() {
      return (role() == 'vendor'
          && (!userDoc(request.auth.uid).keys().hasAny(['vendorApproved'])
            || userDoc(request.auth.uid).vendorApproved == true))
        || (role() == 'home_chef' && userDoc(request.auth.uid).sellerApproved == true);
    }
    function isRider() {
      return role() == 'rider'
        && (!userDoc(request.auth.uid).keys().hasAny(['riderApproved'])
          || userDoc(request.auth.uid).riderApproved == true);
    }
    function isCustomer() { return role() == 'customer'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'phone', 'photoUrl', 'fcmToken', 'updatedAt'
        ]);
      allow delete: if isAdmin();
    }

    match /users/{uid}/addresses/{addressId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.label is string
        && request.resource.data.address is string
        && request.resource.data.phone is string
        && request.resource.data.isDefault is bool;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.label is string
        && request.resource.data.address is string
        && request.resource.data.phone is string
        && request.resource.data.isDefault is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /home_chef_applications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.userId == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.businessName is string
        && request.resource.data.description is string
        && request.resource.data.phone is string
        && request.resource.data.keys().hasOnly(['userId', 'businessName', 'description', 'phone', 'status', 'createdAt', 'updatedAt']);
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == uid
        && resource.data.userId == uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status in ['pending', 'withdrawn']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessName', 'description', 'phone', 'status', 'createdAt', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /vendor_applications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && userDoc(uid).role == 'customer'
        && request.resource.data.userId == uid
        && request.resource.data.applicantName == userDoc(uid).name
        && request.resource.data.email == userDoc(uid).email
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.area is string
        && request.resource.data.details is string
        && request.resource.data.keys().hasOnly(['userId','applicantName','email','name','phone','area','details','status','createdAt','updatedAt']);
      allow update: if signedIn()
        && request.auth.uid == uid
        && userDoc(uid).role == 'customer'
        && resource.data.userId == uid
        && resource.data.status in ['pending','rejected','withdrawn','suspended']
        && request.resource.data.status in ['pending','withdrawn']
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.applicantName == userDoc(uid).name
        && request.resource.data.email == userDoc(uid).email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantName','email','name','phone','area','details','status','createdAt','updatedAt']);
      allow delete: if false;
    }

    match /rider_applications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && userDoc(uid).role == 'customer'
        && request.resource.data.userId == uid
        && request.resource.data.applicantName == userDoc(uid).name
        && request.resource.data.email == userDoc(uid).email
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.area is string
        && request.resource.data.details is string
        && request.resource.data.vehicleType is string
        && request.resource.data.vehicleRegistration is string
        && request.resource.data.keys().hasOnly(['userId','applicantName','email','name','phone','area','details','vehicleType','vehicleRegistration','status','createdAt','updatedAt']);
      allow update: if signedIn()
        && request.auth.uid == uid
        && userDoc(uid).role == 'customer'
        && resource.data.userId == uid
        && resource.data.status in ['pending','rejected','withdrawn','suspended']
        && request.resource.data.status in ['pending','withdrawn']
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.applicantName == userDoc(uid).name
        && request.resource.data.email == userDoc(uid).email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantName','email','name','phone','area','details','vehicleType','vehicleRegistration','status','createdAt','updatedAt']);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if isVendor()
        && (role() != 'home_chef' || userDoc(request.auth.uid).sellerApproved == true)
        && request.resource.data.vendorId == request.auth.uid
        && request.resource.data.vendorType == (role() == 'home_chef' ? 'home_chef' : 'restaurant')
        && request.resource.data.foodCategory in ['restaurant', 'home_made']
        && request.resource.data.menuCategory is string
        && request.resource.data.menuCategory.size() <= 50
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.active is bool
        && request.resource.data.stockQty is int
        && request.resource.data.stockQty >= -1
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 1000;

      allow update: if isVendor()
        && (role() != 'home_chef' || userDoc(request.auth.uid).sellerApproved == true)
        && resource.data.vendorId == request.auth.uid
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.vendorType == (role() == 'home_chef' ? 'home_chef' : 'restaurant')
        && request.resource.data.foodCategory in ['restaurant', 'home_made']
        && request.resource.data.menuCategory is string
        && request.resource.data.menuCategory.size() <= 50
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.active is bool
        && request.resource.data.stockQty is int
        && request.resource.data.stockQty >= -1
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 1000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'foodCategory', 'menuCategory', 'name', 'price', 'active', 'stockQty', 'imageUrl', 'updatedAt'
        ]);

      allow delete: if isVendor()
        && (role() != 'home_chef' || userDoc(request.auth.uid).sellerApproved == true)
        && resource.data.vendorId == request.auth.uid;
    }

    function orderBaseFieldsUnchanged() {
      return request.resource.data.customerId == resource.data.customerId
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total
        && request.resource.data.subtotal == resource.data.subtotal
        && request.resource.data.deliveryFee == resource.data.deliveryFee
        && request.resource.data.platformFee == resource.data.platformFee
        && request.resource.data.commission == resource.data.commission
        && request.resource.data.commissionRate == resource.data.commissionRate
        && request.resource.data.sellerPayout == resource.data.sellerPayout
        && request.resource.data.discount == resource.data.discount
        && request.resource.data.couponCode == resource.data.couponCode
        && request.resource.data.address == resource.data.address
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.refundStatus == resource.data.refundStatus
        && request.resource.data.cancellationReason == resource.data.cancellationReason
        && request.resource.data.deliveryLat == resource.data.deliveryLat
        && request.resource.data.deliveryLng == resource.data.deliveryLng;
    }

    function vendorStatusChange() {
      return isVendor()
        && resource.data.vendorId == request.auth.uid
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.riderId == resource.data.riderId
        && (resource.data.paymentMethod == 'cash_on_delivery' || resource.data.paymentStatus == 'paid')
        && orderBaseFieldsUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && (
          (resource.data.status == 'placed' && request.resource.data.status == 'accepted') ||
          (resource.data.status == 'accepted' && request.resource.data.status == 'preparing') ||
          (resource.data.status == 'preparing' && request.resource.data.status == 'ready')
        );
    }

    function riderStatusChange() {
      return isRider()
        && (resource.data.paymentMethod == 'cash_on_delivery' || resource.data.paymentStatus == 'paid')
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total
        && request.resource.data.subtotal == resource.data.subtotal
        && request.resource.data.deliveryFee == resource.data.deliveryFee
        && request.resource.data.platformFee == resource.data.platformFee
        && request.resource.data.commission == resource.data.commission
        && request.resource.data.commissionRate == resource.data.commissionRate
        && request.resource.data.sellerPayout == resource.data.sellerPayout
        && request.resource.data.discount == resource.data.discount
        && request.resource.data.couponCode == resource.data.couponCode
        && request.resource.data.address == resource.data.address
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.refundStatus == resource.data.refundStatus
        && request.resource.data.cancellationReason == resource.data.cancellationReason
        && request.resource.data.deliveryLat == resource.data.deliveryLat
        && request.resource.data.deliveryLng == resource.data.deliveryLng
        && request.resource.data.riderId == resource.data.riderId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && (
          (resource.data.status == 'ready' && resource.data.riderId == request.auth.uid && request.resource.data.status == 'picked_up') ||
          (resource.data.status == 'picked_up' && resource.data.riderId == request.auth.uid && request.resource.data.status == 'on_the_way')
        );
    }

    match /vendor_settings/{vendorId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isVendor()
        && request.auth.uid == vendorId
        && request.resource.data.vendorId == vendorId
        && request.resource.data.isOpen is bool
        && request.resource.data.openingTime is string
        && request.resource.data.closingTime is string
        && request.resource.data.openingTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.closingTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.keys().hasOnly(['vendorId', 'isOpen', 'openingTime', 'closingTime', 'updatedAt']));
      allow update: if isAdmin() || (isVendor()
        && request.auth.uid == vendorId
        && resource.data.vendorId == vendorId
        && request.resource.data.vendorId == vendorId
        && request.resource.data.isOpen is bool
        && request.resource.data.openingTime is string
        && request.resource.data.closingTime is string
        && request.resource.data.openingTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.closingTime.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vendorId', 'isOpen', 'openingTime', 'closingTime', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /app_settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      // Orders are created only by the trusted createOrderSecure Cloud Function.
      allow create: if false;
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        (isRider() && resource.data.status == 'ready') ||
        isAdmin()
      );
      allow update: if isAdmin() || vendorStatusChange() || riderStatusChange() || (
        signedIn()
        && resource.data.customerId == request.auth.uid
        && resource.data.status == 'placed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total
        && request.resource.data.subtotal == resource.data.subtotal
        && request.resource.data.deliveryFee == resource.data.deliveryFee
        && request.resource.data.platformFee == resource.data.platformFee
        && request.resource.data.commission == resource.data.commission
        && request.resource.data.commissionRate == resource.data.commissionRate
        && request.resource.data.sellerPayout == resource.data.sellerPayout
        && request.resource.data.discount == resource.data.discount
        && request.resource.data.couponCode == resource.data.couponCode
        && request.resource.data.address == resource.data.address
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.deliveryLat == resource.data.deliveryLat
        && request.resource.data.deliveryLng == resource.data.deliveryLng
        && request.resource.data.riderId == resource.data.riderId
        && ((resource.data.paymentMethod == 'cash_on_delivery' || resource.data.paymentStatus != 'paid') && request.resource.data.refundStatus == 'not_applicable' || (resource.data.paymentMethod != 'cash_on_delivery' && resource.data.paymentStatus == 'paid' && request.resource.data.refundStatus == 'pending'))
        && request.resource.data.cancellationReason is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancellationReason','refundStatus','updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /coupons/{code} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'delivered'
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.vendorId == request.resource.data.vendorId;
      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','comment','updatedAt'])
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if signedIn() && resource.data.customerId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      // Notifications are created only by trusted Cloud Functions/Admin.
      allow create: if false;
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.recipientId == request.auth.uid;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      // Payment records are created only by trusted backend functions.
      allow create: if false;
      allow update, delete: if false;
    }

    match /refund_requests/{refundId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.orderId is string
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.paymentStatus == 'paid'
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.total
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    match /support_tickets/{ticketId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /delivery_otp_secrets/{orderId} {
      allow read, create, update, delete: if false;
    }

    match /delivery_otps/{orderId} {
      allow read: if signedIn() && resource.data.customerId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /seller_earnings/{earningId} {
      allow read: if signedIn() && (isAdmin() || resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /seller_payout_balances/{sellerId} {
      allow read, create, update, delete: if false;
    }

    match /payout_requests/{requestId} {
      allow read: if signedIn() && (isAdmin() || resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() && (isAdmin() || resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /rider_locations/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isCustomer() && resource.data.keys().hasAny(['visibleToCustomerIds'])
          && resource.data.visibleToCustomerIds is list
          && resource.data.visibleToCustomerIds.hasAny([request.auth.uid]))
      );
      allow write: if signedIn() && request.auth.uid == uid && isRider()
        && (!request.resource.data.keys().hasAny(['lat']) || (request.resource.data.lat is number
          && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
        && (!request.resource.data.keys().hasAny(['lng']) || (request.resource.data.lng is number
          && request.resource.data.lng >= -180 && request.resource.data.lng <= 180))
        && request.resource.data.visibleToCustomerIds is list
        && request.resource.data.visibleToCustomerIds.size() <= 20
        && request.resource.data.keys().hasOnly(['lat','lng','updatedAt','visibleToCustomerIds']);
    }
  }
}
